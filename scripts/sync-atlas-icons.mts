import { execFileSync } from 'node:child_process'
import { mkdtemp, realpath, rm, writeFile } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import { basename, extname, join, posix } from 'node:path'
const { ATLAS_BUNDLES } = await import(new URL('../src/lib/atlas.ts', import.meta.url).href) as {
  ATLAS_BUNDLES: Readonly<Record<string, string>>
}

interface PackedPlugin {
  name: string
  filename: string
  version: string
  files: { path: string, size: number }[]
}

const MAX_ICON_BYTES = 256 * 1024
const MIME_TYPES = new Map([
  ['.svg', 'image/svg+xml'],
  ['.png', 'image/png'],
  ['.jpg', 'image/jpeg'],
  ['.jpeg', 'image/jpeg'],
  ['.webp', 'image/webp'],
])
const targets = Object.entries(ATLAS_BUNDLES)
const directory = await mkdtemp(join(await realpath(tmpdir()), 'dsh-atlas-icons-'))

try {
  const cli = process.env.npm_execpath
  const npm = cli && basename(cli) === 'npm-cli.js' ? cli : undefined
  const packages = JSON.parse(execFileSync(npm ? process.execPath : 'npm', [
    ...(npm ? [npm] : []),
    // Always write the input archives, including during the manager's own npm pack --dry-run.
    'pack', '--ignore-scripts', '--dry-run=false', '--json', '--registry=https://registry.npmjs.org/',
    '--pack-destination', directory, '--cache', join(directory, 'cache'),
    ...targets.map(([, name]) => `${name}@latest`),
  ], { cwd: directory, encoding: 'utf8', timeout: 60000 })) as PackedPlugin[]

  const entries = targets.map(([atlas, name]) => {
    const pack = packages.find(item => item.name === name)
    if (!pack || typeof pack.filename !== 'string' || basename(pack.filename) !== pack.filename || !pack.filename.endsWith('.tgz')) {
      throw new Error(`No npm archive for ${name}`)
    }
    const archive = join(directory, pack.filename)
    const readMember = (path: string, maxBuffer: number) => execFileSync('tar', ['-xOf', archive, `package/${path}`], {
      maxBuffer, timeout: 10000,
    })
    const manifest = JSON.parse(readMember('package.json', MAX_ICON_BYTES).toString('utf8')) as {
      name: string, version: string, icon?: unknown, exports?: Record<string, unknown>
    }
    if (manifest.name !== name || manifest.version !== pack.version) throw new Error(`Unexpected manifest for ${name}`)
    const resource = manifest.icon ?? manifest.exports?.['./icon']
    const path = typeof resource === 'string' ? posix.normalize(resource) : ''
    const mime = MIME_TYPES.get(extname(path).toLowerCase())
    const file = pack.files.find(item => item.path === path)
    if (posix.isAbsolute(path) || path.startsWith('../') || mime === undefined || !file || file.size > MAX_ICON_BYTES) {
      throw new Error(`No supported icon in ${name}@${pack.version}`)
    }
    const bytes = readMember(path, MAX_ICON_BYTES)
    if (!bytes.length || bytes.length !== file.size) throw new Error(`Incomplete icon in ${name}@${pack.version}`)
    const url = `data:${mime};base64,${bytes.toString('base64')}`
    console.log(`${name}@${pack.version}: ${path} (${bytes.length} bytes)`)
    const source = JSON.stringify(`${name}@${pack.version}/${path}`)
    return `  // ${source}\n  ${atlas}: ${JSON.stringify(url)},`
  })

  await writeFile(new URL('../src/client/published-icons.ts', import.meta.url), [
    '// Generated by scripts/sync-atlas-icons.mjs from the icons in published npm packages.',
    "import type { Atlas } from '../lib/atlas.js'",
    '',
    'export const ATLAS_ICONS = {',
    ...entries,
    '} satisfies Record<Atlas, string>',
    '',
  ].join('\n'))
} finally {
  await rm(directory, { recursive: true, force: true })
}
